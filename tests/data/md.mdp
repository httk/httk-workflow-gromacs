; Short NVT molecular dynamics of the argon box, 50 steps
integrator      = md
dt              = 0.002
nsteps          = 50
gen-vel         = yes
gen-temp        = 100
gen-seed        = 1
tcoupl          = v-rescale
tc-grps         = System
tau-t           = 0.1
ref-t           = 100

cutoff-scheme   = Verlet
coulombtype     = cutoff
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz

nstlist         = 10
nstenergy       = 10
nstlog          = 10
nstcalcenergy   = 10
