; Minimal steepest-descent energy minimization, 50 steps max
integrator      = steep
emtol           = 100.0
emstep          = 0.01
nsteps          = 50

cutoff-scheme   = Verlet
coulombtype     = cutoff
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz

nstlist         = 10
nstenergy       = 1
nstlog          = 1
