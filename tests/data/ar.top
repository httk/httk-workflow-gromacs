; Minimal topology: 8 argon atoms as a custom LJ atomtype, no bonds
[ defaults ]
; nbfunc  comb-rule  gen-pairs
1          2          no

[ atomtypes ]
; name  at.num   mass      charge  ptype   sigma      epsilon
  AR    18       39.948    0.000   A       0.3405     0.996

[ moleculetype ]
; name  nrexcl
AR       1

[ atoms ]
; nr  type  resnr  residue  atom  cgnr  charge  mass
1     AR    1      AR       AR    1     0.0     39.948

[ system ]
Tiny argon cube

[ molecules ]
; molecule name  number
AR                8
